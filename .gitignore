# Build artefacts
/game
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Go workspace
go.work
go.work.sum

# Environment
.env

# Editor
.idea/
.vscode/

# The original asset files are never committed: they are supplied by the
# user on their own disk and are only read by the "import" subcommand.
/assets/raw/*
!/assets/raw/.gitkeep

# The save files of the local sessions.
/saves/

# The local build output.
/game-debug

# The audit log of the importer: it is regenerated by every import run.
/assets/config/import.log
